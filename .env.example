# Copy this file to .env during setup.  Do not commit the real API key.
SIRI_AGENT_API_KEY=replace-with-a-random-secret-generated-by-setup
SIRI_AGENT_PORT=8000
SIRI_AGENT_BIND=0.0.0.0
SIRI_AGENT_LOG_LEVEL=INFO
SIRI_AGENT_CONFIG_DIR=config
SIRI_AGENT_RUNTIME_DIR=runtime
SIRI_AGENT_SHUTDOWN_CONFIRMATION_SECONDS=60
SIRI_AGENT_RATE_LIMIT_PER_MINUTE=120
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback
SPOTIFY_DEVICE_NAME=
SPOTIFY_TOKEN_PATH=runtime/spotify_token.json

# Local AI is disabled by default.  Use shadow only after a deliberate local
# benchmark run; production fallback requires a separately accepted gate.
LOCAL_AI_ENABLED=false
LOCAL_AI_MODE=off
LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_AI_MODEL=
LOCAL_AI_TIMEOUT_SECONDS=2.0
LOCAL_AI_MAX_RESPONSE_BYTES=32768
LOCAL_AI_FALLBACK_APPROVED=false
